{
  "name": "kelpie-api",
  "version": "0.7.1",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "start": "wrangler -c wrangler.dev.toml dev",
    "test": "npm run test:autoscale && npm run test:reliability && vitest run --no-file-parallelism",
    "test:autoscale": "vitest run --config vitest.autoscale.config.js --no-file-parallelism",
    "benchmark:autoscale": "python3 scripts/benchmark-autoscaler.py",
    "test:reliability": "vitest run --config vitest.reliability.config.js --no-file-parallelism",
    "test:integration:local": "vitest run --config vitest.integration-local.config.js --no-file-parallelism",
    "test:local": "npm run test:autoscale && npm run test:reliability && npm run test:integration:local"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.32",
    "@cloudflare/workers-types": "^4.20240208.0",
    "@types/node": "^20.11.19",
    "typescript": "^5.0.4",
    "wrangler": "^4"
  },
  "dependencies": {
    "@cloudflare/itty-router-openapi": "^1.0.10",
    "jose": "5.10.0",
    "zod": "^3.22.4"
  }
}
